[Unit]
Description=Grigliato production Telegram bot
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/production_bot
ExecStart=/opt/production_bot/venv/bin/python /opt/production_bot/main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
